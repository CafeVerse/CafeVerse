{
  "name": "cafeverse",
  "version": "0.4.7",
  "description": "An Electron application with React and TypeScript",
  "main": "./out/main/index.js",
  "author": "Vikum Karunathilake",
  "homepage": "https://cafeverse.github.io",
  "license": "Apache-2.0",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "bun run typecheck:node && bun run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "NODE_ENV=production bun run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "bun run build && electron-builder --dir",
    "build:win": "NODE_ENV=production bun run build && electron-builder --win",
    "build:mac": "NODE_ENV=production bun run build && electron-builder --mac",
    "build:linux": "NODE_ENV=production bun run build && electron-builder --linux"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@ghostery/adblocker-electron": "^2.18.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@xhayper/discord-rpc": "^1.3.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-fetch": "^4.1.0",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.9",
    "express": "^5.2.1",
    "lucide-react": "^1.26.0",
    "radix-ui": "^1.6.7",
    "react-router": "^8.3.0",
    "shadcn": "^4.15.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "overrides": {
    "form-data": "^4.0.6",
    "tmp": "^0.2.6",
    "hono": "^4.12.25",
    "undici": "^6.27.0",
    "@hono/node-server": "^2.0.5",
    "body-parser": "^1.20.3",
    "brace-expansion": "^5.0.8",
    "@babel/core": "^7.29.1",
    "app-builder-lib": "^26.15.3",
    "builder-util-runtime": "^9.7.0",
    "esbuild": "^0.28.1",
    "turbo-stream": "^3.0.0",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",

    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.5.4",
    "electron": "^42.7.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "postcss": "^8.5.23",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.5"
  }
}
